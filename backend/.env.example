# Bu dosyayi .env olarak kopyala ve gercek bir deger gir.
# .env git'e commit edilmez (.gitignore'da) - JWT_SECRET_KEY ayarlanmazsa
# backend gelistirme icin guvensiz bir varsayilana geri doner ve bir
# RuntimeWarning basar (bkz. app/auth.py).
#
# Rastgele bir deger uretmek icin:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
